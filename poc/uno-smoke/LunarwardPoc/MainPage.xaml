<Page x:Class="LunarwardPoc.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lp="using:LunarwardPoc"
      Background="#18181C">

  <Grid>
    <!-- 左侧 48px 着色条：上游 MainView 用 CustomAcrylicBrush/Backdrop，这里先验证版式 -->
    <Border Width="48" HorizontalAlignment="Left">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#22232A" Offset="0" />
          <GradientStop Color="#1B1C22" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <NavigationView Name="Nav"
                    CompactPaneLength="48"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    PaneDisplayMode="LeftCompact"
                    SelectionChanged="Nav_SelectionChanged"
                    Background="Transparent">
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
      </NavigationView.Resources>

      <NavigationView.MenuItems>
        <NavigationViewItem Tag="launcher" Content="启动器" IsSelected="True">
          <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE80F;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="gacha" Content="抽卡记录">
          <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE8A9;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="shot" Content="截图">
          <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE722;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="gsetting" Content="游戏设置">
          <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE9F5;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="control" Content="控件验收">
          <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Tag="setting" Content="设置">
          <NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <Grid>
        <ScrollViewer x:Name="PageLauncher">
          <StackPanel Padding="32,20,32,28" Spacing="14">

            <StackPanel Orientation="Horizontal" Spacing="12">
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE80F;" FontSize="22" Foreground="#8AB4F8" />
              <TextBlock Text="原神" FontSize="26" FontWeight="SemiBold" Foreground="#F2F2F5" VerticalAlignment="Center" />
              <Border Background="#2E2F37" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <TextBlock Text="5.2.0" FontSize="12" Foreground="#C6C8D3" />
              </Border>
              <Border Background="#23303F" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                <TextBlock Text="已安装 · hk4e_cn" FontSize="12" Foreground="#7FB2F0" />
              </Border>
            </StackPanel>

            <Grid Height="212">
              <Border CornerRadius="12">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2A3A55" Offset="0" />
                    <GradientStop Color="#1F2733" Offset="0.55" />
                    <GradientStop Color="#191C24" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <TextBlock Text="横幅 / 事件图（M1 接 Starward.Assets 的 GameStartupBg 与视频）"
                         Foreground="#6E768A" FontSize="13"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Background="#CC16181D" CornerRadius="8" Margin="16" Padding="14,10"
                      VerticalAlignment="Bottom">
                <StackPanel Spacing="4">
                  <TextBlock Text="hoYoPlay 启动器 · 游戏公告" FontSize="13" Foreground="#E8E8EE" />
                  <TextBlock Text="公告内容区域（WebView 方案待 G0-3 验证）" FontSize="12" Foreground="#8C93A8" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" Height="56" HorizontalAlignment="Stretch"
                      Background="#3B6FD4" Foreground="White" CornerRadius="10"
                      BorderThickness="0" Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                  <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE768;" FontSize="18" Foreground="White" />
                  <TextBlock Text="开始游戏" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Grid.Column="1" Height="56" Width="56" CornerRadius="10" BorderThickness="0" Background="#26272E">
                <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE713;" FontSize="19" Foreground="#D0D0D8" />
              </Button>
              <Button Grid.Column="2" Height="56" Width="56" CornerRadius="10" BorderThickness="0" Background="#26272E">
                <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE7BA;" FontSize="19" Foreground="#D0D0D8" />
              </Button>
            </Grid>

            <Grid ColumnSpacing="28" Margin="2,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="本次" FontSize="12" Foreground="#8C93A8" />
                <TextBlock Text="00:42" FontSize="19" Foreground="#E8E8EE" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="总计" FontSize="12" Foreground="#8C93A8" />
                <TextBlock Text="128.5 小时" FontSize="19" Foreground="#E8E8EE" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="运行环境" FontSize="12" Foreground="#8C93A8" HorizontalAlignment="Right" />
                <TextBlock Text="wine 10.12 + DXVK 2.4 · profile: genshin-main" FontSize="13" Foreground="#B9BCC9" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="#2A2B33" Margin="0,6,0,2" />

            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Background="#23242B" CornerRadius="10" Padding="14,12" Width="220" BorderBrush="#3B6FD4" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE80F;" FontSize="18" Foreground="#8AB4F8" VerticalAlignment="Center" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="原神" FontSize="14" Foreground="#EDEDF2" />
                    <TextBlock Text="5.2.0 · 已安装" FontSize="11" Foreground="#8C93A8" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Background="#1F2027" CornerRadius="10" Padding="14,12" Width="220">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE8A9;" FontSize="18" Foreground="#7A8090" VerticalAlignment="Center" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="崩坏：星穹铁道" FontSize="14" Foreground="#C9CBD5" />
                    <TextBlock Text="3.2.0 · 未安装" FontSize="11" Foreground="#7A8090" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Background="#1F2027" CornerRadius="10" Padding="14,12" Width="220">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE9D9;" FontSize="18" Foreground="#7A8090" VerticalAlignment="Center" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="绝区零" FontSize="14" Foreground="#C9CBD5" />
                    <TextBlock Text="2.1.0 · 未安装" FontSize="11" Foreground="#7A8090" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageGacha" Visibility="Collapsed">
          <StackPanel Padding="32,20,32,28" Spacing="14">
            <TextBlock Text="抽卡记录" FontSize="24" FontWeight="SemiBold" Foreground="#F2F2F5" />
            <Border Background="#202128" CornerRadius="10" Padding="18">
              <StackPanel Spacing="8">
                <TextBlock Text="角色活动祈愿 · 共 213 抽" FontSize="13" Foreground="#C9CBD5" />
                <ProgressBar Value="0.62" Height="6" CornerRadius="3" Foreground="#3B6FD4" Background="#2A2B33" />
                <TextBlock Text="距上次 5★ 已 74 抽 · 平均值 62.4" FontSize="12" Foreground="#8C93A8" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="GachaList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#1D1E25" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding Accent}" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Foreground="#E8E8EE" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Pulls}" FontSize="12" Foreground="#8C93A8" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageShot" Visibility="Collapsed">
          <StackPanel Padding="32,20,32,28" Spacing="14">
            <TextBlock Text="截图" FontSize="24" FontWeight="SemiBold" Foreground="#F2F2F5" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="全部" Background="#3B6FD4" Foreground="White" CornerRadius="8" BorderThickness="0" />
              <Button Content="原神" Background="#26272E" Foreground="#C9CBD5" CornerRadius="8" BorderThickness="0" />
              <Button Content="绝区零" Background="#26272E" Foreground="#C9CBD5" CornerRadius="8" BorderThickness="0" />
            </StackPanel>
            <GridView>
              <Border Width="184" Height="112" CornerRadius="8" Background="#2A3A55" Margin="0,0,10,10" />
              <Border Width="184" Height="112" CornerRadius="8" Background="#33405A" Margin="0,0,10,10" />
              <Border Width="184" Height="112" CornerRadius="8" Background="#24304A" Margin="0,0,10,10" />
              <Border Width="184" Height="112" CornerRadius="8" Background="#2E3B54" Margin="0,0,10,10" />
              <Border Width="184" Height="112" CornerRadius="8" Background="#283549" Margin="0,0,10,10" />
              <Border Width="184" Height="112" CornerRadius="8" Background="#31405B" Margin="0,0,10,10" />
            </GridView>
            <TextBlock Text="缩略图由 Starward.Codec 解码（AVIF / JXL / UltraHDR），M0 只验证网格布局。"
                       FontSize="12" Foreground="#7A8090" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageGSetting" Visibility="Collapsed">
          <StackPanel Padding="32,20,32,28" Spacing="14">
            <TextBlock Text="游戏设置 · 原神" FontSize="24" FontWeight="SemiBold" Foreground="#F2F2F5" />
            <Border Background="#202128" CornerRadius="10" Padding="18">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="运行环境 profile" FontSize="13" Foreground="#C9CBD5" />
                  <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="genshin-main（wine 10.12 + DXVK 2.4）" />
                    <ComboBoxItem Content="genshin-dxvk-nvapi 测试" />
                    <ComboBoxItem Content="genshin-proton-exp（Proton 直连）" />
                  </ComboBox>
                </StackPanel>
                <ToggleSwitch Header="伴随启动：MangoHud" IsOn="True" />
                <ToggleSwitch Header="伴随启动：帧率解锁 patch（注入型，需确认）" IsOn="False" />
                <ToggleSwitch Header="启动后打开调试 shell" IsOn="False" />
                <TextBlock Text="上述条目对应 Profile 的 companions 数组，触发时机与注入方式见 03-runtime-model.md。"
                           FontSize="12" Foreground="#7A8090" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageControl" Visibility="Collapsed">
          <StackPanel Padding="32,20,32,28" Spacing="14">
            <TextBlock Text="控件覆盖验收" FontSize="24" FontWeight="SemiBold" Foreground="#F2F2F5" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="InfoBar 正常渲染" Message="上游 82 个 XAML 里高频出现的控件，逐类确认可用。" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                     Title="Warning 级" Message="样式与 WinUI 基线基本一致。" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="主按钮" Background="#3B6FD4" Foreground="White" CornerRadius="8" BorderThickness="0" />
              <Button Content="次按钮" Background="#26272E" Foreground="#E8E8EE" CornerRadius="8" BorderThickness="0" />
              <Button Content="禁用" IsEnabled="False" CornerRadius="8" />
            </StackPanel>
            <StackPanel Spacing="8">
              <ToggleSwitch Header="ToggleSwitch" IsOn="True" />
              <ToggleSwitch Header="ToggleSwitch（关）" />
              <Slider Value="42" Width="320" HorizontalAlignment="Left" />
              <ProgressBar Value="0.65" Width="320" HorizontalAlignment="Left" Height="6" CornerRadius="3" />
              <ProgressRing IsActive="True" Width="28" Height="28" HorizontalAlignment="Left" />
            </StackPanel>
            <Expander Header="Expander（可展开）" HorizontalAlignment="Stretch" IsExpanded="True">
              <TextBlock Text="展开内容区正常。" Foreground="#C9CBD5" Padding="0,8" />
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE80F;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE768;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE713;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE8A9;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE896;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE9D9;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE7BA;" FontSize="22" Foreground="#8AB4F8" />
              <FontIcon FontFamily="{StaticResource LunarIcons}" Glyph="&#xE8B7;" FontSize="22" Foreground="#8AB4F8" />
            </StackPanel>
            <TextBlock Text="8 个 Segoe Fluent Icons 字形（E80F / E768 / E713 / E8A9 / E896 / E9D9 / E7BA / E8B7）"
                       FontSize="12" Foreground="#7A8090" />
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PageSetting" Visibility="Collapsed">
          <StackPanel Padding="32,20,32,28" Spacing="14">
            <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Foreground="#F2F2F5" />
            <Border Background="#202128" CornerRadius="10" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Text="外观" FontSize="15" Foreground="#EDEDF2" />
                <ComboBox Header="主题" SelectedIndex="0" Width="280" HorizontalAlignment="Left">
                  <ComboBoxItem Content="跟随系统" />
                  <ComboBoxItem Content="浅色" />
                  <ComboBoxItem Content="深色" />
                </ComboBox>
                <ToggleSwitch Header="启用背景模糊（Linux 下需合成器支持）" IsOn="True" />
                <ToggleSwitch Header="托盘图标" IsOn="True" />
                <TextBlock Text="数据目录" FontSize="13" Foreground="#C9CBD5" />
                <TextBlock Text="~/.local/share/lunarward" FontSize="12" Foreground="#8C93A8" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </NavigationView>

    <lp:CompatPage x:Name="PageCompat" Visibility="Collapsed" />

    <!-- WebView 尖峰：验证 Uno WebView2 在 Linux Skia 后端是否可用（对应 G0-3 / R-02） -->
    <Border x:Name="WebHost" Visibility="Collapsed" Background="#101014">
      <WebView2 x:Name="Probe" Source="https://user.miyoushe.com/" />
    </Border>
  </Grid>
</Page>

