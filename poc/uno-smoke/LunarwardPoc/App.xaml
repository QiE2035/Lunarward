<Application x:Class="LunarwardPoc.App"
       RequestedTheme="Dark"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- G0-7：直接使用上游 Starward.Assets 里的 Segoe Fluent Icons -->
      <FontFamily x:Key="SegoeFluentIcons">ms-appx:///Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>
          <FontFamily x:Key="SfiNoSpace">ms-appx:///Assets/Fonts/sfi.ttf#Segoe Fluent Icons</FontFamily>
      <FontFamily x:Key="SfiMdl2">ms-appx:///Assets/Fonts/sfi.ttf#Segoe MDL2 Assets</FontFamily>
          <FontFamily x:Key="LunarIcons">ms-appx:///Assets/Fonts/lunar-icons.ttf#LunarIconsTest</FontFamily>

      <!-- 关键：Uno 会拦截 "Segoe Fluent Icons"/"Segoe MDL2 Assets" 这两个家族名并替换为内置描边字体。
           因此把上游 ttf 改名（Lunarward Icons）后，用隐式样式让所有 <FontIcon> 自动继承，
           这样上游 82 个 XAML 里的 <FontIcon Glyph="..." /> 不用改一行代码就能拿到实心图标。 -->
      <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource LunarIcons}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>

</Application>
