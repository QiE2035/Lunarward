<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- LUNARWARD-DEVIATION: .NET 11 的隐式 using 含 System.Net.Http.Json，.NET 10 没有；见 D128。 -->
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Localization\CoreLang.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CoreLang.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\CoreLang.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>CoreLang.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
