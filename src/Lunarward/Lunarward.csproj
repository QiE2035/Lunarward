<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <RootNamespace>Starward</RootNamespace>
    <AssemblyName>Lunarward</AssemblyName>
    <!-- 版本号参与 User-Agent，为空会产生非法 header（见 13-lessons L-26） -->
    <Version>0.1.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <InformationalVersion>0.1.0-linux</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <EnableDefaultUnoItems>true</EnableDefaultUnoItems>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <!-- Lunarward：交给 Uno 生成入口点，不使用上游的 WinUI 专用 Main -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ApplicationManifest />
    <Platforms>AnyCPU</Platforms>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS8632;CS8618;CS8625;CS8602;CS8604;CS8600;CS8603;CS8629;CS0169;CS0649;CS0067;CS0108;CS0414</NoWarn>
  </PropertyGroup>

  <!-- 上游 Starward.Assets 里的图片/字体/模板：直接从 vendor 镜像链接进输出，不再复制一份进仓库 -->
  <ItemGroup>
    <Content Include="../../vendor/upstream/large-resource/Starward.Assets/Assets/**/*"
             Link="Assets/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 上游把入口点交给 Uno 生成，因此 App.xaml 必须显式声明为 ApplicationDefinition -->
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />
