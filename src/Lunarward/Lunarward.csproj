  <!-- Hi3Helper.ZstdNet 固定到 Lib/linux-x64 找 libzstd，而发行版只有 libzstd.so.1；
       这里给它放符号链接，避免要求用户装 zstd 开发包。 -->
  <Target Name="LunarwardZstdShim" AfterTargets="Build" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="sh -c 'src=&quot;&quot;; for c in /usr/lib/libzstd.so.1 /usr/lib/x86_64-linux-gnu/libzstd.so.1 /lib/libzstd.so.1 /usr/local/lib/libzstd.so.1; do [ -e &quot;$c&quot; ] &amp;&amp; src=&quot;$c&quot; &amp;&amp; break; done; [ -n &quot;$src&quot; ] || exit 0; mkdir -p &quot;$(OutDir)Lib/linux-x64&quot;; for n in libzstd libzstd-bmi2; do ln -sf &quot;$src&quot; &quot;$(OutDir)Lib/linux-x64/$n.so&quot;; done'" />
  </Target>

  <Target Name="LunarwardZstdShimPublish" AfterTargets="Publish" Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="sh -c 'src=&quot;&quot;; for c in /usr/lib/libzstd.so.1 /usr/lib/x86_64-linux-gnu/libzstd.so.1 /lib/libzstd.so.1 /usr/local/lib/libzstd.so.1; do [ -e &quot;$c&quot; ] &amp;&amp; src=&quot;$c&quot; &amp;&amp; break; done; [ -n &quot;$src&quot; ] || exit 0; mkdir -p &quot;$(PublishDir)Lib/linux-x64&quot;; for n in libzstd libzstd-bmi2; do ln -sf &quot;$src&quot; &quot;$(PublishDir)Lib/linux-x64/$n.so&quot;; done'" />
  </Target>
</Project>
