<sf:PageBase x:Class="Starward.Features.GameSetting.GameSettingPage"
             NavigationCacheMode="Required"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.GameSetting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <!--  Linux：设置类页面给实底，避免游戏背景的大字透到表单文字后面（D61）。  -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ScrollViewer_Main">
          <StackPanel>
            <!--  绑定悬空提示（D61）：方案被删掉后这里会显示一条可点的提示，避免用户不知情地用错运行器  -->
            <InfoBar Margin="24,20,24,0"
                     IsClosable="False"
                     IsOpen="{x:Bind IsProfileBindingMissing}"
                     Severity="Warning"
                     Title="运行环境绑定失效"
                     Message="{x:Bind MissingProfileBindingMessage}"
                     Visibility="{x:Bind IsProfileBindingMissing}">
                <InfoBar.ActionButton>
                    <Button Click="Button_RebindProfile_Click" Content="重新选择运行环境" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid Margin="24,20,24,24" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Width="0"
                        Height="0"
                        IsHitTestVisible="False" />

                <StackPanel Margin="0,0,12,0" Visibility="{x:Bind IsBaseSettingEnable}">
                    <!--  分辨率  -->
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.GameSettingPage_Resolution}" />
                    <!--  全屏  -->
                    <CheckBox Margin="0,8,0,0"
                              Content="{x:Bind lang:Lang.GameSettingPage_FullScreen}"
                              IsChecked="{x:Bind EnableFullScreen, Mode=TwoWay}" />
                    <!--  无边框窗口  -->
                    <CheckBox Margin="0,8,0,0"
                              Content="{x:Bind lang:Lang.GameSettingPage_UsePopupWindow}"
                              IsChecked="{x:Bind UsePopupWindow, Mode=TwoWay}" />
                    <!--  自定义分辨率  -->
                    <CheckBox Margin="0,8,0,0"
                              Content="{x:Bind lang:Lang.GameSettingPage_CustomResolution}"
                              IsChecked="{x:Bind EnableCustomResolution, Mode=TwoWay}" />
                    <ComboBox Name="ComboBox_Resolution"
                              Width="160"
                              Margin="0,8,0,0"
                              IsEnabled="{x:Bind EnableCustomResolution, Converter={StaticResource BoolReversedConverter}}"
                              SelectionChanged="ComboBox_Resolution_SelectionChanged" />
                    <StackPanel Margin="0,12,0,0"
                                Orientation="Horizontal"
                                Spacing="12">
                        <NumberBox Width="120"
                                   IsEnabled="{x:Bind EnableCustomResolution}"
                                   Minimum="0"
                                   Value="{x:Bind ResolutionWidth, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="20"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="×" />
                        <NumberBox Width="120"
                                   IsEnabled="{x:Bind EnableCustomResolution}"
                                   Minimum="0"
                                   Value="{x:Bind ResolutionHeight, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  语音  -->
                    <TextBlock Margin="0,20,0,0"
                               FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.GameSettingPage_VoiceLanguage}"
                               Visibility="{x:Bind IsLanguageSettingEnable}" />
                    <!--  首次启动游戏前设置此值可以避免下载部分语音资源  -->
                    <TextBlock Margin="0,12,0,0"
                               Text="{x:Bind lang:Lang.GameSettingPage_VoiceLanguageDescription}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind IsLanguageSettingEnable}" />
                    <ComboBox Width="160"
                              Margin="0,8,0,0"
                              SelectedIndex="{x:Bind LanguageIndex, Mode=TwoWay}"
                              Visibility="{x:Bind IsLanguageSettingEnable}">
                        <!--  汉英日韩  -->
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_Chinese}" />
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_English}" />
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_Japanese}" />
                        <ComboBoxItem Content="{x:Bind lang:Lang.Language_Korean}" />
                    </ComboBox>
                </StackPanel>


                <!--  Lunarward：上游此处是 Grid.Row="1"（原 Grid 只有一行，会被夹到第 0 行），
                      我们给 Grid 加了行定义后必须显式改成第 0 行，否则会与「后启动程序」分区重叠。  -->
                <StackPanel Grid.Column="1"
                            Spacing="12"
                            Visibility="{x:Bind IsGraphicsSettingEnable}">
                    <!--  图形设置  -->
                    <TextBlock FontSize="20"
                               FontWeight="Bold"
                               Text="{x:Bind lang:Lang.GameSettingPage_GraphicsSetting}" />

                    <!--  星铁帧率  -->
                    <StackPanel x:Name="StackPanel_StarRailFPS"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock VerticalAlignment="Bottom"
                                   FontWeight="Bold"
                                   Text="{x:Bind lang:Lang.GameSettingPage_FPS}" />
                        <ComboBox Width="120" SelectedIndex="{x:Bind StarRailFpsIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="30" />
                            <ComboBoxItem Content="60" />
                            <ComboBoxItem Content="120" />
                        </ComboBox>
                        <!--  请勿将游戏内「图像质量」修改为「自定义」以外的选项  -->
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GameSettingPage_StarRailFpsTip}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  原神 HDR  -->
                    <StackPanel x:Name="StackPanel_GenshinHDR"
                                Spacing="8"
                                Visibility="Collapsed">
                        <TextBlock FontWeight="Bold" Text="HDR" />
                        <CheckBox Content="{x:Bind lang:Lang.GameSettingPage_EnableHDR}" IsChecked="{x:Bind EnableGenshinHDR, Mode=TwoWay}" />
                        <Button Command="{x:Bind OpenGenshinHDRLumianceSettingWindowCommand}" Content="{x:Bind lang:Lang.GameSettingPage_HDRBrightnessSetting}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind lang:Lang.GameSettingPage_IfYouHaveMultipleMonitorsYouNeedToSetTheHDRSupportedMonitorAsThePrimaryDisplay}"
                                   TextWrapping="Wrap" />
                        <InfoBar Title="{x:Bind lang:Lang.GameSettingPage_TheCurrentMonitorDoesNotSupportHDR}"
                                 Margin="0,0,24,0"
                                 IsClosable="False"
                                 IsOpen="True"
                                 Severity="Warning"
                                 Visibility="{x:Bind HDRNotSupported}" />
                        <InfoBar Title="{x:Bind lang:Lang.GameSettingPage_WindowsHDRIsNotTurnedOn}"
                                 Margin="0,0,24,0"
                                 IsClosable="False"
                                 IsOpen="True"
                                 Severity="Warning"
                                 Visibility="{x:Bind HDRNotEnabled}" />
                    </StackPanel>

                </StackPanel>


                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,32,0,8"
                            Spacing="8">
                    <TextBlock FontSize="20" FontWeight="Bold" Text="运行配置" />
                    <TextBlock MaxWidth="760"
                               HorizontalAlignment="Left"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="这个游戏使用哪套运行环境（Wine/Proton 运行器、图形组件、Wine 前缀与环境变量）。配置本身在「设置 → 运行环境」里管理。"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="ComboBox_Profile"
                              MinWidth="360"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Left"
                              DisplayMemberPath="Name"
                              SelectionChanged="ComboBox_Profile_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,24,0,8"
                            Spacing="8">
                    <TextBlock FontSize="20" FontWeight="Bold" Text="{x:Bind lang:Lang.Lunarward_Companion_Section}" />
                    <TextBlock MaxWidth="760"
                               HorizontalAlignment="Left"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.Lunarward_Companion_Description}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="Button_AddCompanion" Click="Button_AddCompanion_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind lang:Lang.Lunarward_Companion_Add}" />
                            </StackPanel>
                        </Button>
                        <Button Click="Button_OpenCompanionFolder_Click" Content="{x:Bind lang:Lang.Lunarward_Companion_OpenFolder}" />
                    </StackPanel>
                    <TextBlock x:Name="TextBlock_CompanionEmpty"
                               Margin="0,8,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind lang:Lang.Lunarward_Companion_Empty}" />
                    <StackPanel x:Name="Panel_Companions" Spacing="8" />
                </StackPanel>

                <!--  诊断（D63 §6）：跑一次启动预检，把六项结果摊开，失败项可直接跳去修  -->
                <StackPanel Margin="0,24,0,0" Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="诊断" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="启动前会检查可执行文件、运行器、前缀、占用与图形层。这里可以手动跑一次。"
                        TextWrapping="Wrap" />
                    <Button x:Name="Button_Diagnose" Click="Button_Diagnose_Click" Content="运行启动检查" />
                </StackPanel>

            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!--  游戏未安装  -->
        <StackPanel Name="StackPanel_Emoji"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <Image Name="Image_Emoji"
                   Width="160"
                   Height="160" />
            <TextBlock Name="TextBlock_GameNotInstalled"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.GameSettingPage_GameNotInstalled}" />
        </StackPanel>


        <Grid Name="Grid_ApplyBackground"
              Grid.Row="1"
              Background="{ThemeResource CustomOverlayAcrylicBrush}"
              CornerRadius="8,0,0,0">

            <StackPanel Margin="24,0,24,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Height="36"
                        BorderThickness="0"
                        Command="{x:Bind ApplySettingCommand}"
                        CornerRadius="18"
                        IsEnabled="{x:Bind IsApplyButtonEnable}"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Margin="12,0,12,0"
                                Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon VerticalAlignment="Center"
                                  FontSize="16"
                                  Glyph="&#xE8FB;" />
                        <!--  应用  -->
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind lang:Lang.Common_Apply}" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ErrorMessage}"
                           TextTrimming="WordEllipsis" />
            </StackPanel>
        </Grid>

    </Grid>
</sf:PageBase>
