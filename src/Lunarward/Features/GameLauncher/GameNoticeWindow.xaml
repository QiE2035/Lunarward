<?xml version="1.0" encoding="utf-8" ?>
<sf:WindowEx x:Class="Starward.Features.GameLauncher.GameNoticeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Starward.Features.GameLauncher"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:Starward.Frameworks"
             mc:Ignorable="d">

    <Grid Loaded="Grid_Loaded">
        <Border Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#60000000"
                CornerRadius="8">
            <ProgressRing Width="60"
                          Height="60"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                          IsIndeterminate="True" />
        </Border>
        <WebView2 Name="webview"
                  DefaultBackgroundColor="Transparent"
                  Visibility="Collapsed">
            <WebView2.Resources>
                <SolidColorBrush x:Key="BrushForThemeBackgroundColor" Color="Transparent" />
            </WebView2.Resources>
        </WebView2>
        <TextBlock x:Name="TextBlock_Fallback"
                   MaxWidth="520"
                   Margin="0,0,0,40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="若窗口一直黑屏，说明当前 Linux 构建的内置浏览器没能加载页面，请点右下角「在浏览器中打开」。"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="Button_OpenInBrowser"
                Padding="12,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,12"
                Click="Button_OpenInBrowser_Click"
                Content="在浏览器中打开" />
    </Grid>
</sf:WindowEx>
