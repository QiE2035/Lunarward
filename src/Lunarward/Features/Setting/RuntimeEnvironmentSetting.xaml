<?xml version="1.0" encoding="utf-8"?>
<sf:PageBase
    x:Class="Starward.Features.Setting.RuntimeEnvironmentSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="using:Starward.Language"
    xmlns:local="using:Starward.Features.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:runtime="using:Starward.Features.Runtime"
    xmlns:sf="using:Starward.Frameworks"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Margin="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_Title}" />
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_Description}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="Button_New" Click="Button_New_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_New}" />
                    </StackPanel>
                </Button>
                <Button x:Name="Button_Refresh" Click="Button_Refresh_Click">
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="{x:Bind lang:Lang.Common_Refresh}" />
                    </StackPanel>
                </Button>
                <Button x:Name="Button_OpenFolder" Click="Button_OpenFolder_Click">
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_Companion_OpenFolder}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ScrollViewer_Content"
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                    <!--  运行器：只读清单 + 手动添加路径（D63 三段式第一段）  -->
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="运行器" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="只读清单：启动器只发现和选择，不安装、不复制、不删除系统里的 wine。要固定某个版本请用包管理器装到独立目录，再用「添加路径…」指过来。"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button x:Name="Button_AddRunner" Click="Button_AddRunner_Click" Content="添加路径…" />
                    </StackPanel>
                    <StackPanel x:Name="StackPanel_Runners" Margin="0,4,0,0" Spacing="4" />

                    <!--  方案  -->
                    <TextBlock
                        Margin="0,16,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="方案" />
                    <StackPanel x:Name="StackPanel_Profiles" Margin="0,4,0,0" Spacing="4" />

                    <!--  前缀：单独成段，看得到「谁在用它/多大/什么状态」  -->
                    <TextBlock
                        Margin="0,16,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="前缀" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="wine 的 C 盘。会坏、会占几十 G、会被多个方案共用，所以单独列出来；外部前缀只显示不清理。"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="StackPanel_Prefixes" Margin="0,4,0,0" Spacing="4" />

                    <!--  图形组件（DXVK / VKD3D）：仍放在组件区，P3 再按前缀收敛  -->
                    <TextBlock
                        Margin="0,16,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_Components}" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_ComponentsNote}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="Button_DownloadComponent"
                            Click="Button_DownloadComponent_Click"
                            Content="下载组件…" />
                        <Button
                            x:Name="Button_ImportArchive"
                            Click="Button_ImportArchive_Click"
                            Content="导入归档…" />
                        <Button
                            x:Name="Button_ImportGraphics"
                            Click="Button_ImportGraphics_Click"
                            Content="{x:Bind lang:Lang.Lunarward_RuntimeEnv_ImportGraphics}" />
                    </StackPanel>
                    <StackPanel x:Name="StackPanel_Components" Margin="0,4,0,0" Spacing="4" />
                </StackPanel>
            </ScrollViewer>

            <!--  方案编辑（D63 §4）：整页视图，列表暂时隐藏，标题栏带「返回」  -->
            <ScrollViewer
                x:Name="ScrollViewer_Editor"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel
                    x:Name="StackPanel_Editor"
                    MaxWidth="760"
                    HorizontalAlignment="Left"
                    Spacing="8" />
            </ScrollViewer>
            </Grid>

    </Grid>
</sf:PageBase>
