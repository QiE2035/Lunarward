<?xml version="1.0" encoding="utf-8"?>
<sf:PageBase
    x:Class="Starward.Features.Setting.RuntimeEnvironmentSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="using:Starward.Language"
    xmlns:local="using:Starward.Features.Setting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:runtime="using:Starward.Features.Runtime"
    xmlns:sf="using:Starward.Frameworks"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Margin="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_Title}" />
                <TextBlock
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_Description}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="Button_New" Click="Button_New_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_New}" />
                    </StackPanel>
                </Button>
                <Button x:Name="Button_Refresh" Click="Button_Refresh_Click">
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="{x:Bind lang:Lang.Common_Refresh}" />
                    </StackPanel>
                </Button>
                <Button x:Name="Button_OpenFolder" Click="Button_OpenFolder_Click">
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_Companion_OpenFolder}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer
                x:Name="ScrollViewer_Content"
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                    <StackPanel x:Name="StackPanel_Profiles" Spacing="4" />
                    <TextBlock
                        Margin="0,16,0,0"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_Components}" />
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind lang:Lang.Lunarward_RuntimeEnv_ComponentsNote}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="Button_ImportGraphics"
                            Click="Button_ImportGraphics_Click"
                            Content="{x:Bind lang:Lang.Lunarward_RuntimeEnv_ImportGraphics}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="StackPanel_Components"
                        Margin="0,4,0,0"
                        Spacing="4" />
                </StackPanel>
            </ScrollViewer>

    </Grid>
</sf:PageBase>
