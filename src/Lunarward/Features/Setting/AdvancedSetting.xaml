<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="Starward.Features.Setting.AdvancedSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Setting"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="using:Starward"
             xmlns:sf="using:Starward.Features"
             xmlns:sh="using:Starward.Helpers"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel>

            <!--  诊断（D61）：替代 Windows 的「获得管理员权限」入口  -->
            <TextBlock Margin="0,20,0,0" FontSize="20" Text="{x:Bind lang:Lang.Lunarward_Diagnose_Title}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.Lunarward_Diagnose_Description}"
                       TextWrapping="Wrap" />
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12">
                <Button Height="40"
                        Click="Button_CreateDiagnose_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xF412;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_Diagnose_Create}" />
                    </StackPanel>
                </Button>
                <Button Height="40" Click="Button_OpenDiagnoseFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_Diagnose_OpenFolder}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  运行输出（Lunarward / D27）  -->
            <TextBlock Margin="0,20,0,0" FontSize="20" Text="{x:Bind lang:Lang.Lunarward_Output_Title}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap">
                游戏本体与「后启动程序」的 stdout/stderr 会一直捕获并落盘（默认不清屏、不改动游戏行为）；这里只控制「怎么看」。
            </TextBlock>
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12">
                <Button Height="40"
                        Click="Button_ViewOutput_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE9D9;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_Output_View}" />
                    </StackPanel>
                </Button>
                <Button Height="40" Click="Button_OpenOutputFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                        <TextBlock Text="{x:Bind lang:Lang.Lunarward_Output_OpenFolder}" />
                    </StackPanel>
                </Button>
            </StackPanel>


        </StackPanel>
    </ScrollViewer>

</sf:PageBase>
