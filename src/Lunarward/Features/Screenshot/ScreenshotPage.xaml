<sf:PageBase
             NavigationCacheMode="Required" x:Class="Starward.Features.Screenshot.ScreenshotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lang="using:Starward.Language"
             xmlns:local="using:Starward.Features.Screenshot"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mxi="using:Microsoft.Xaml.Interactivity"
             xmlns:s="using:Starward"
             xmlns:sc="using:Starward.Controls"
             xmlns:sf="using:Starward.Frameworks"
             xmlns:sh="using:Starward.Helpers"
             xmlns:ui="using:CommunityToolkit.WinUI"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--<TextBlock Margin="24,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Bind lang:Lang.ScreenshotPage_GameScreenshot}" />-->


        <StackPanel Name="StackPanel_Emoji"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Visibility="Collapsed">
            <Image Name="Image_Emoji"
                   Width="160"
                   Height="160" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind lang:Lang.ScreenshotPage_ScreenshotFolderDoesNotExist}" />
        </StackPanel>



        <!-- Lunarward：上游这里是 GridView + GroupStyle + ItemsWrapGrid（按日期分组）。
             Uno 6.7 下这个组合不渲染任何条目（L-48），所以换成 ItemsControl + WrapPanel 的扁平网格；
             条目外观（缩略图 + 文件名 + 悬停菜单）保持上游观感，多选/批量转换等交互在 M3 后续补。 -->
        <ScrollViewer x:Name="ScrollViewer_Images"
                      Grid.Row="0"
                      Grid.RowSpan="2"
                      Padding="24,0,12,12"
                      Visibility="Collapsed">
            <ItemsControl x:Name="ItemsControl_Images"
                          ItemsSource="{x:Bind ScreenshotViewSource.View}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <tk:WrapPanel HorizontalSpacing="12" VerticalSpacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ScreenshotItem">
                        <Border Margin="0,0,0,0"
                                Padding="6"
                                CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Width="218">
                            <StackPanel Spacing="6">
                                <Grid Height="116"
                                      Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                      CornerRadius="4">
                                    <sc:CachedImage Width="206"
                                                    Height="116"
                                                    Stretch="UniformToFill"
                                                    Source="{x:Bind FilePath}" />
                                    <CheckBox Margin="4"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left"
                                              Background="{ThemeResource ControlFillColorDefaultBrush}"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock FontSize="12"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{x:Bind Name}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


        <StackPanel Margin="0,0,28,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="12">
            <TextBlock x:Name="TextBlock_SelectCount"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind SelectCountText, Mode=OneWay}" />
            <ToggleButton x:Name="ToggleButton_MultiSelect"
                          Content="{x:Bind lang:Lang.ScreenshotPage_MultiSelect}"
                          IsChecked="{x:Bind MutliSelect, Mode=TwoWay}" />
            <Button x:Name="Button_BatchConvert"
                    Command="{x:Bind OpenImageBatchConvertWindowCommand}"
                    Content="{x:Bind lang:Lang.ScreenshotPage_BatchConvert}" />
            <Button Command="{x:Bind ManageScreenshotFolderCommand}" Content="{x:Bind lang:Lang.ScreenshotPage_ManageScreenshotFolders}" />
        </StackPanel>


    </Grid>
</sf:PageBase>
