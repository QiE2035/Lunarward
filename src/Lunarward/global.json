{
  "msbuild-sdks": {
    "Uno.Sdk": "7.0.22"
  },
  "sdk": {
    // 只钉到最低 feature band；钉具体 feature band（如 11.0.302）会让装了较低版本
    // SDK 的环境直接报 "A compatible .NET SDK was not found"。Arch/AUR 的
    // dotnet-sdk 版本不固定，见 D89 / L-163。与仓库根 global.json 保持一致（D128）。
    "version": "11.0.100",
    "rollForward": "latestFeature"
  }
}
