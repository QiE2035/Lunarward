<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Lunarward.Tests</RootNamespace>
    <!-- 测试只覆盖纯逻辑，直接链接源文件，避免引用 Uno UI 工程（D37）。 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/PrefixPath.cs" Link="Linked/PrefixPath.cs" />
    <Compile Include="../../src/Lunarward/Helpers/JsonFile.cs" Link="Linked/JsonFile.cs" />
    <Compile Include="../../src/Lunarward/Features/GameAccount/RegistryFormat.cs" Link="Linked/RegistryFormat.cs" />
    <Compile Include="../../src/Lunarward/Features/GameAccount/WineRegistryFiles.cs" Link="Linked/WineRegistryFiles.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/ComponentManifest.cs" Link="Linked/ComponentManifest.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/ComponentDownloadMath.cs" Link="Linked/ComponentDownloadMath.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/ComponentSources.cs" Link="Linked/ComponentSources.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/LaunchRecipe.cs" Link="Linked/LaunchRecipe.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/Enhancements.cs" Link="Linked/Enhancements.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/LaunchHistoryStore.cs" Link="Linked/LaunchHistoryStore.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/RuntimeProfile.cs" Link="Linked/RuntimeProfile.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/ArchiveExtractor.cs" Link="Linked/ArchiveExtractor.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/SteamLibrary.cs" Link="Linked/SteamLibrary.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/OutputCapture.cs" Link="Linked/OutputCapture.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/PeArchitecture.cs" Link="Linked/PeArchitecture.cs" />
    <Compile Include="../../src/Lunarward/Features/Runtime/RunnerNaming.cs" Link="Linked/RunnerNaming.cs" />
    <Compile Include="../../src/Lunarward/Helpers/CliSpec.cs" Link="Linked/CliSpec.cs" />
    <Compile Include="../../src/Starward.GameInstall/Service/HardLinkCompat.cs" Link="Linked/HardLinkCompat.cs" />
    <Compile Include="../../src/Starward.GameInstall/Service/WinePrefixRegistry.cs" Link="Linked/WinePrefixRegistry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- JsonFile 链接了主工程的日志调用；测试里只用来编译，不初始化 Sink -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <!-- ArchiveExtractor 用到的解压实现（与主工程同版本） -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <!-- SteamLibrary 用 ValveKeyValue 读 VDF，PeArchitecture 用 PeNet 读 PE 头（D78） -->
    <PackageReference Include="ValveKeyValue" Version="0.80.0.542" />
    <PackageReference Include="PeNet" Version="6.1.2" />
  </ItemGroup>

</Project>
