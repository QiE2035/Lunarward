<?xml version="1.0" encoding="utf-8"?>
<!-- Lunarward：测试工程用「链接源码」的方式编译被测逻辑（见 D37 / 19-test-plan.md），
     被测代码因此位于测试程序集内部，而 coverlet 默认不统计测试程序集本身。
     这里显式打开 IncludeTestAssembly，覆盖率才不会是 0。 -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <!-- 测试工程与被测源码在同一个程序集里（链接源码，D37），所以上面必须开 IncludeTestAssembly。
               但这会把测试文件自己也统计进来：它们几乎 100% 覆盖，会把分母整体拉高，
               等于用测试代码给自己刷分。这里把 tests/ 下的文件排除，口径只留 src/Lunarward/。 -->
          <ExcludeByFile>**/tests/Lunarward.Tests/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <Exclude>[xunit.*]*,[Microsoft.*]*,[Serilog]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
